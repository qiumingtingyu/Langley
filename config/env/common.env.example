# Copy to .env.common.local. Never put actual credentials in this template.
# Only the explicit local_env.py dev command loads this file's local copy.
LANGLEY_ENVIRONMENT=development
LANGLEY_LOCAL_USER_ID=1
# Required: fill the application's MySQL connection locally (not langley_test).
# LANGLEY_DATABASE_URL=<fill-locally>
LANGLEY_LOG_LEVEL=INFO
LANGLEY_LOG_FORMAT=console
LANGLEY_LOCAL_TIMEZONE=UTC
LANGLEY_KNOWLEDGE_STORAGE_ROOT=data/knowledge
LANGLEY_QDRANT_URL=http://127.0.0.1:6333

LANGLEY_WEB_SEARCH_ENABLED=false
# TAVILY_API_KEY=<fill-locally>
LANGLEY_TRACING_ENABLED=false
LANGLEY_TRACE_CONTENT_ENABLED=false
# LANGLEY_LANGSMITH_PROJECT=langley-local
# LANGSMITH_API_KEY=<fill-locally>
# Keep local diagnostics available without recording content by default.
LANGLEY_LOCAL_RUN_DIAGNOSTICS_INCLUDE_CONTENT=false

# Provider, model names and Memory Policy write budget belong in provider files.
# Test/Eval database settings belong in separate test/Eval configuration.
