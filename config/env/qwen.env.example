# Copy to .env.qwen.local. Fill credentials locally; do not commit that file.
LANGLEY_LLM_PROVIDER=qwen
# LANGLEY_QWEN_API_KEY=<fill-locally>
# LANGLEY_QWEN_BASE_URL=<fill-locally>
LANGLEY_LLM_MODEL=qwen3.7-plus-2026-05-26
LANGLEY_CONVERSATION_COMPACTOR_MODEL=qwen3.7-plus-2026-05-26

# Optional. Configure model AND calibrated write budget together.
# Preserve your current Qwen configuration when migrating an existing setup.
# LANGLEY_MEMORY_POLICY_MODEL=qwen3.7-plus-2026-05-26
# LANGLEY_MEMORY_POLICY_ESTIMATED_TOKEN_BUDGET=24576
