# Copy to .env.deepseek.local. DeepSeek uses non-thinking mode only.
LANGLEY_LLM_PROVIDER=deepseek
# Canonical Langley name; DEEPSEEK_API_KEY is not a Settings alias.
# LANGLEY_DEEPSEEK_API_KEY=<fill-locally>
LANGLEY_DEEPSEEK_BASE_URL=https://api.deepseek.com
LANGLEY_LLM_MODEL=deepseek-flash
LANGLEY_CONVERSATION_COMPACTOR_MODEL=deepseek-flash

# Memory Policy remains unconfigured until an explicit budget is selected.
# Do not inherit Qwen's model or its budget by switching only the provider.
# LANGLEY_MEMORY_POLICY_MODEL=deepseek-flash
# LANGLEY_MEMORY_POLICY_ESTIMATED_TOKEN_BUDGET=<fill-locally>
