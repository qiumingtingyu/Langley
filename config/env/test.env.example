# Copy to .env.test.local for explicit real-MySQL integration tests only.
# Must use MySQL and the exact database name langley_test.
# LANGLEY_TEST_DATABASE_URL=<fill-locally>
# Optional, for integration suites using a dedicated test Qdrant service:
# LANGLEY_QDRANT_URL=http://127.0.0.1:6333
# No development DATABASE_URL, model credentials, Web or Trace configuration.
