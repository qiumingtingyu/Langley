# Safe reference only. Settings do not auto-load this file; set LANGLEY_*
# variables explicitly in the shell that runs Langley commands.
#
# Development and integration databases have separate roles. Tests may reset
# only langley_test and must never use the development URL.
LANGLEY_ENVIRONMENT=development
LANGLEY_LOG_LEVEL=INFO
LANGLEY_LOG_FORMAT=console
LANGLEY_DATABASE_URL=mysql+asyncmy://root:replace-with-local-mysql-password@127.0.0.1:3306/langley
LANGLEY_TEST_DATABASE_URL=mysql+asyncmy://root:replace-with-local-mysql-password@127.0.0.1:3306/langley_test
# Explicit local/demo principal used by the current no-auth development flow.
LANGLEY_LOCAL_USER_ID=1

# Slice 4 real-service settings. Keep actual credentials in the shell only.
LANGLEY_LLM_PROVIDER=qwen
LANGLEY_QWEN_API_KEY=replace-in-shell-only
LANGLEY_QWEN_BASE_URL=https://provider-issued-openai-compatible-base-url
LANGLEY_LLM_MODEL=qwen3.7-plus-2026-05-26
LANGLEY_HISTORY_ESTIMATED_TOKEN_BUDGET=16000
LANGLEY_MAX_LLM_ROUNDS=4
LANGLEY_MAX_TOOL_CALLS=3
LANGLEY_OVERALL_WORKFLOW_DEADLINE_SECONDS=180

# LangSmith remains disabled by default. LANGSMITH_API_KEY is an SDK variable;
# set it only in a private shell during the explicit content-off smoke.
LANGLEY_TRACING_ENABLED=false
LANGLEY_TRACE_CONTENT_ENABLED=false
LANGLEY_LANGSMITH_PROJECT=
